{$APP_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    @private path /internal/* /admin/*
    respond @private 404
    redir /reticle /reticle/
    handle_path /reticle/* {
        reverse_proxy host.docker.internal:8788 {
            header_up Authorization "Bearer {$RETICLE_VIEW_TOKEN}"
            # Compatibility with this Go daemon's embedded import map.
            header_down Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-g5AdRu1jyblWRbnnojUsm9HniZqjEZpTro+LQ24gT3I='; connect-src 'self'; frame-src https: http:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
            header_down Cache-Control "no-store, no-transform"
        }
    }
    # Reticle's Go/Wails frontend uses root-relative websocket/API routes.
    @reticle path /ws /api/graph /api/history /mcp /vendor/*
    handle @reticle {
        reverse_proxy host.docker.internal:8788 {
            header_up Authorization "Bearer {$RETICLE_VIEW_TOKEN}"
        }
    }
    handle {
        reverse_proxy prod-web:8000 {
            health_uri /health/ready
            health_interval 10s
        }
    }
}
