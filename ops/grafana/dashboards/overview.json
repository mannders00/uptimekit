{
  "uid": "uptimekit", "title": "UptimeKit • Infrastructure ownership", "schemaVersion": 39,
  "tags": ["uptimekit"], "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id":1,"title":"Application / dependencies","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"up{job=\"django\"}","legendFormat":"{{environment}} scrape"},{"expr":"uptimekit_database_up","legendFormat":"{{environment}} postgres"},{"expr":"uptimekit_redis_up","legendFormat":"{{environment}} redis"}]},
    {"id":2,"title":"Monitor the monitor: freshness (seconds)","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"uptimekit_canary_age_seconds","legendFormat":"{{environment}} canary"},{"expr":"uptimekit_dispatcher_age_seconds","legendFormat":"{{environment}} dispatcher"},{"expr":"uptimekit_worker_age_seconds","legendFormat":"{{environment}} worker"}]},
    {"id":3,"title":"Durable backlog / broker queue","type":"timeseries","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"uptimekit_pending_jobs","legendFormat":"{{environment}} pending"},{"expr":"uptimekit_queue_depth","legendFormat":"{{environment}} queued"},{"expr":"uptimekit_oldest_pending_seconds","legendFormat":"{{environment}} oldest seconds"}]},
    {"id":4,"title":"HTTP p95 latency","type":"timeseries","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,environment) (rate(uptimekit_http_duration_seconds_bucket[5m])))","legendFormat":"{{environment}} seconds"}]},
    {"id":5,"title":"Host memory / root disk available","type":"timeseries","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes","legendFormat":"Memory ratio"},{"expr":"node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}","legendFormat":"Disk ratio"}]},
    {"id":6,"title":"Alerts firing / pending","type":"timeseries","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"ALERTS","legendFormat":"{{alertname}} {{environment}} {{alertstate}}"}]},
    {"id":7,"title":"Backup / restore age (seconds)","type":"timeseries","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"time() - uptimekit_backup_timestamp_seconds","legendFormat":"{{environment}} backup"},{"expr":"time() - uptimekit_restore_timestamp_seconds","legendFormat":"{{environment}} restore drill"},{"expr":"time() - uptimekit_offhost_backup_timestamp_seconds","legendFormat":"{{environment}} off-host"}]},
    {"id":8,"title":"Billing and notification failures","type":"timeseries","gridPos":{"x":12,"y":24,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"uptimekit_notification_failed","legendFormat":"{{environment}} mail failed"},{"expr":"uptimekit_billing_stale","legendFormat":"{{environment}} billing stale"},{"expr":"increase(uptimekit_webhook_failures_total[5m])","legendFormat":"{{environment}} webhook {{reason}}"}]}
  ]
}
