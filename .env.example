ENVIRONMENT=dev
APP_IMAGE=ghcr.io/mannders00/uptimekit@sha256:REPLACE_WITH_CI_DIGEST
APP_ENV_FILE=/etc/uptimekit/dev.env
WEB_PORT=8001
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
DJANGO_ALLOWED_HOSTS=uptimekit.masoftware.net,localhost,127.0.0.1,web,dev-web,prod-web
SITE_URL=https://uptimekit.masoftware.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://uptimekit.masoftware.net
POSTGRES_HOST=db
POSTGRES_DB=uptimekit
POSTGRES_USER=uptimekit
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CHECK_PROXY=http://check-proxy:3128
OPS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Monitoring is free unless billing is explicitly enabled.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
EMAIL_BACKEND=core.mail.DisabledEmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=uptimekit@masoftware.net
REPORT_BUCKET=
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
